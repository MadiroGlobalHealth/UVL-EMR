  "@openmrs/esm-patient-registration-app": {
    "Display conditions": {
      "privileges": ["Add Patients", "Edit Patients"]
    },
    "sections": [
      "demographics",
      "contact",
      "additionalInformation",
      "relationships"
    ],
    "fieldDefinitions": [
      {
        "id": "telephoneNumber",
        "type": "person attribute",
        "uuid": "14d4f066-15f5-102d-96e4-000c29c2a5d7",
        "label": "Telephone Number",
        "validation": {
          "required": false,
          "matches": "^\\+?(\\d{1,3})?[-.\\s]?(\\(?\\d{1,4}?\\)?)?[-.\\s]?\\d{1,4}[-.\\s]?\\d{1,4}[-.\\s]?\\d{1,9}$"
        }
      },
      {
        "id": "maritalStatus",
        "type": "person attribute",
        "uuid": "c65ebb91-0de1-4622-9af4-bf9e19ea569b",
        "label": "Marital status",
        "validation": {
          "required": false
        },
        "answerConceptSetUuid": "1732bde0-dcf0-4aea-9ea4-470f08b7675c"
      },
      {
        "id": "occupation",
        "type": "person attribute",
        "uuid": "96a9f1a6-7bd4-4147-a5b3-98b1f6137340",
        "label": "Occupation",
        "validation": {
          "required": false
        },
        "answerConceptSetUuid": "b1effaa8-afeb-41f5-9226-0bdcc52a6ea9"
      },
      {
        "id": "chefDeMenage",
        "type": "person attribute",
        "uuid": "c108c6bc-5f23-4e4a-ad34-8c788b86f288",
        "label": "Chef de ménage (Head of household)",
        "validation": {
          "required": false
        }
      }
    ],
    "sectionDefinitions": [
      {
        "id": "demographics",
        "fields": ["name", "gender", "dob", "id"]
      },
      {
        "id": "contact",
        "name": "Contact Details",
        "fields": ["address", "telephoneNumber"]
      },
      {
        "id": "additionalInformation",
        "name": "Additional Information",
        "fields": ["maritalStatus", "occupation", "chefDeMenage"]
      }
    ],
    "fieldConfigurations": {
      "name": {
        "displayCapturePhoto": false,
        "allowUnidentifiedPatients": true
      },
      "dateOfBirth": {
        "useEstimatedDateOfBirth": {
          "enabled": true,
          "dayOfMonth": 15,
          "month": 5
        }
      },
      "address": {
        "useAddressHierarchy": {
          "searchAddressByLevel": true
        }
      }
    },
    "registrationObs": {
      "encounterTypeUuid": "10d061d8-0677-47f2-8061-f302244dc48b",
      "encounterProviderRoleUuid": "240b26f9-dd88-4172-823d-4a8bfeb7841f"
    },
    "Translation overrides": {
      "en": {
        "Additional Information": "Additional Information",
        "Occupation": "Occupation",
        "Marital Status": "Marital Status"
      },
      "fr": {
        "Additional Information": "Informations supplémentaires",
        "Occupation": "Profession",
        "Marital Status": "Statut matrimonial"
