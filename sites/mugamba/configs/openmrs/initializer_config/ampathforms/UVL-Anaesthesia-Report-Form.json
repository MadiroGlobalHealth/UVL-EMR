        {
          "label": "Timing of the Surgical and Anaesthetic Procedure",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Start of Anaesthesia",
              "type": "obs",
              "id": "anaesthesiaStart",
              "required": true,
              "questionOptions": {
                "rendering": "datetime",
                "concept": "19c203ac-fb85-41c0-94b1-b084ec8058b7"
              }
            },
            {
              "label": "End of Anaesthesia",
              "type": "obs",
              "id": "anaesthesiaEnd",
              "required": true,
              "questionOptions": {
                "rendering": "datetime",
                "concept": "0b1f6973-0377-49be-b1c3-7295dea5f87d"
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && !isEmpty(anaesthesiaStart) && new Date(myValue) - new Date(anaesthesiaStart) < 0",
                  "message": "The end of anaesthesia must be after its start"
                }
              ]
            },
            {
              "label": "Duration of Anaesthesia (min)",
              "type": "obs",
              "id": "anaesthesiaDuration",
              "questionOptions": {
                "rendering": "number",
                "concept": "e97f88cb-a37e-42b2-8830-16e75ffe2bf9",
                "calculate": {
                  "calculateExpression": "!isEmpty(anaesthesiaStart) && !isEmpty(anaesthesiaEnd) && new Date(anaesthesiaEnd) - new Date(anaesthesiaStart) >= 0 ? Math.round((new Date(anaesthesiaEnd) - new Date(anaesthesiaStart)) / 60000) : undefined"
                },
                "min": "0",
                "disallowDecimals": true
              }
            },
            {
              "label": "Start of the Procedure",
              "type": "obs",
              "id": "surgeryStart",
              "questionOptions": {
                "rendering": "datetime",
                "concept": "01f8fb65-57ac-4743-8d00-d8c405789cb2"
              }
            },
            {
              "label": "End of the Procedure",
              "type": "obs",
              "id": "surgeryEnd",
              "questionOptions": {
                "rendering": "datetime",
                "concept": "a8f782e5-64e5-460d-a304-e8cd4acb1388"
              },
              "validators": [
                {
                  "type": "js_expression",
                  "failsWhenExpression": "!isEmpty(myValue) && !isEmpty(surgeryStart) && new Date(myValue) - new Date(surgeryStart) < 0",
                  "message": "The end of the procedure must be after its start"
                }
              ]
            },
            {
              "label": "Duration of the Procedure (min)",
              "type": "obs",
              "id": "surgeryDuration",
              "questionOptions": {
                "rendering": "number",
                "concept": "545878d1-6198-4dab-9a90-952e38b8e306",
                "calculate": {
                  "calculateExpression": "!isEmpty(surgeryStart) && !isEmpty(surgeryEnd) && new Date(surgeryEnd) - new Date(surgeryStart) >= 0 ? Math.round((new Date(surgeryEnd) - new Date(surgeryStart)) / 60000) : undefined"
                },
                "min": "0",
                "disallowDecimals": true
              }
            }
