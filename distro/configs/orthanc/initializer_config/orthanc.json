{
  "Name": "Orthanc inside Docker",
  "StorageDirectory": "/var/lib/orthanc/db",
  "StorageCompression": false,
  "MaximumStorageSize": 0,
  "MaximumPatientCount": 0,
  "PostgreSQL": {
    "EnableIndex": true,
    "EnableStorage": false,
    "Host": "postgresql",
    "Port": 5432,
    "Database": "orthanc",
    "Username": "orthanc",
    "Password": "orthanc",
    "Lock": false,
    "IndexConnectionsCount": 50,
    "TransactionMode": "ReadCommitted"
  },
  "HttpPort": 8042,
  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": false,
  "DicomAet": "ORTHANC",
  "DicomPort": 4242,
  "DicomAlwaysAllowStore": true,
  "DicomAlwaysAllowEcho": true,
  "StoneWebViewer": {},
  "OverwriteInstances": true,
  "SaveJobs": true,
  "ConcurrentJobs": 2,
  "Authorization": {
    "WebServiceRootUrl": "http://orthanc-auth-service:8000/",
    "WebServiceUsername": "orthanc",
    "WebServicePassword": "orthanc",
    "CheckedLevel": "studies",
    "TokenHttpHeaders": [
      "token"
    ],
    "TokenGetArguments": [
      "token"
    ],
    "StandardConfigurations": [
      "orthanc-explorer-2",
      "stone-webviewer",
      "ohif"
    ],
    "UncheckedFolders": [
      "/auth/",
      "/ohif/",
      "/ui/"
    ]
  },
  "DicomModalities": {
    "XmaruPro": [
      "XMARU",
      "192.168.1.XX",
      104
    ],
    "FINDSCU": [
      "FINDSCU",
      "192.168.65.1",
      1
    ]
  },
  "OrthancExplorer2": {
    "IsDefaultOrthancUI": true,
    "Keycloak": {
      "Enable": true,
      "Url": "${KEYCLOAK_URL}/",
      "Realm": "ozone",
      "ClientId": "orthanc"
    },
    "UiOptions": {
      "EnableShares": true,
      "ShareType": "stone-viewer-publication",
      "InstantLinksValidity": 3600,
      "OhifViewer3PublicRoot": "${PACS_PUBLIC_URL}/ohif/"
    }
  },
  "OHIF": {
    "DataSource": "dicom-web",
    "RouterBasename": "${OHIF_ROUTER_BASENAME}",
    "UserConfiguration": "/usr/share/orthanc/ohif/app-config.js"
  },
  "HttpAllowOrigin": "*",
  "HttpAllowCredentials": false,
  "HttpAllowMethods": "GET, POST, PUT, DELETE, OPTIONS",
  "HttpAllowHeaders": "Authorization, Content-Type, Accept, token",
  "ImagingWorklistURL": "http://openmrs:8080/openmrs/ws/rest/v1/worklist/requests",
  "ImagingUpdateRequestStatus": "http://openmrs:8080/openmrs/ws/rest/v1/worklist/updaterequeststatus",
  "ImagingWorklistUsername": "admin",
  "ImagingWorklistPassword": "Admin123",
  "PythonScript": "/etc/orthanc/orthancWorklist.py",
  "DicomAlwaysAllowFind": true,
  "UnknownSopClassAccepted": true,
  "Worklists": {
    "Enable": true,
    "Directory": "/var/lib/orthanc/worklists"
  }
}