<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:pro="http://www.liquibase.org/xml/ns/pro"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
                        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.1.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
	<!--
		Providers on encounters and orders, for the treating-doctor and prescriber
		columns of the visits dashboard (UVL-EMR#222, #205). Column order matches
		dsl/flattening/queries/encounter_providers.sql and providers.sql, because
		the flattening job inserts by position.
	-->
	<changeSet id="1791360000-1" author="jnsereko">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="encounter_providers"/>
			</not>
		</preConditions>
		<createTable tableName="encounter_providers">
			<column name="encounter_provider_id" type="BIGINT">
				<constraints nullable="false" primaryKey="true" primaryKeyName="encounter_providers_pkey"/>
			</column>
			<column name="encounter_uuid" type="VARCHAR"/>
			<column name="provider_id" type="BIGINT"/>
			<column name="provider_uuid" type="VARCHAR"/>
			<column name="provider_name" type="VARCHAR"/>
			<column name="encounter_role" type="VARCHAR"/>
			<column name="encounter_provider_voided" type="BOOLEAN"/>
		</createTable>
	</changeSet>
	<changeSet id="1791360000-2" author="jnsereko">
		<preConditions onFail="MARK_RAN">
			<not>
				<indexExists tableName="encounter_providers" indexName="idx_encounter_providers_encounter_uuid"/>
			</not>
		</preConditions>
		<createIndex tableName="encounter_providers" indexName="idx_encounter_providers_encounter_uuid">
			<column name="encounter_uuid"/>
		</createIndex>
	</changeSet>
	<changeSet id="1791360000-3" author="jnsereko">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="providers"/>
			</not>
		</preConditions>
		<createTable tableName="providers">
			<column name="provider_id" type="BIGINT">
				<constraints nullable="false" primaryKey="true" primaryKeyName="providers_pkey"/>
			</column>
			<column name="provider_uuid" type="VARCHAR"/>
			<column name="person_uuid" type="VARCHAR"/>
			<column name="provider_name" type="VARCHAR"/>
			<column name="provider_identifier" type="VARCHAR"/>
			<column name="provider_retired" type="BOOLEAN"/>
		</createTable>
	</changeSet>
</databaseChangeLog>
