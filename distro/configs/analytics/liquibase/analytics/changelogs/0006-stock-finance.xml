			<column name="operation_type" type="VARCHAR"/>
			<column name="operation_type_code" type="VARCHAR"/>
			<column name="status" type="VARCHAR"/>
			<column name="operation_date" type="TIMESTAMP"/>
			<column name="location_id" type="BIGINT"/>
			<column name="location" type="VARCHAR"/>
			<column name="source" type="VARCHAR"/>
			<column name="destination" type="VARCHAR"/>
			<column name="reason_concept_id" type="BIGINT"/>
			<column name="completed_date" type="TIMESTAMP"/>
			<column name="cancelled_date" type="TIMESTAMP"/>
			<column name="date_created" type="TIMESTAMP"/>
			<column name="voided" type="BOOLEAN"/>
		</createTable>
		<createIndex tableName="stock_operations" indexName="idx_stock_operations_operation_date">
			<column name="operation_date"/>
		</createIndex>
	</changeSet>
	<changeSet id="1795500004" author="jnsereko">
