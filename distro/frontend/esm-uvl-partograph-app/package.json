{
  "name": "@madiro/esm-uvl-partograph-app",
  "version": "1.1.0",
  "license": "MPL-2.0",
  "private": true,
  "description": "UVL maternity charting: the partograph of the patient's Partograph Reading encounters (WHO alert and action lines, UVL-EMR #498), a side-panel button that opens the Partograph Reading form, and the 24-Hour Surveillance table (UVL-EMR #565)",
  "browser": "dist/madiro-esm-uvl-partograph-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "build": "rspack --mode production",
    "typescript": "tsc",
    "test": "cross-env TZ=UTC vitest run"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "uvl",
    "partograph",
    "maternity"
  ],
  "dependencies": {
    "@carbon/react": "^1.83.0",
    "@openmrs/esm-patient-common-lib": "13.0.2-pre.12863"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "11.x",
    "dayjs": "1.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "rxjs": "6.x"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "11.0.0",
    "@openmrs/esm-styleguide": "11.0.0",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.6",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.13",
    "happy-dom": "^20.0.0",
    "i18next": "^25.0.0",
    "openmrs": "11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^6.14.1",
    "rxjs": "^6.6.7",
    "single-spa": "^6.0.3",
    "swr": "^2.2.5",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  }
}
