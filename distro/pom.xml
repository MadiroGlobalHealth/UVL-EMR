    <patientsummaryVersion>2.2.0</patientsummaryVersion>     
  	<msf.environment>dev</msf.environment>
    <bundled.docker.tag>${msf.environment}</bundled.docker.tag>

    <!--
      Orthanc secrets written into run/docker/.env and concatenated.env at build
      time. The defaults are deliberately NOT usable: this repository is public, and
      anything committed here stays in git history for good.

      Supply the real values on the build, e.g.

        mvn package -Porthanc \
          -Dorthanc.client.secret="$ORTHANC_CLIENT_SECRET" \
          -Dorthanc.auth.service.secret.key="$ORTHANC_AUTH_SERVICE_SECRET_KEY"

      orthanc.client.secret must match the "orthanc-service" client secret in the
      site's ozone-realm.json.
    -->
    <orthanc.client.secret>CHANGEME</orthanc.client.secret>
    <orthanc.auth.service.secret.key>CHANGEME</orthanc.auth.service.secret.key>
